# which LLM to use: groq or bedrock
LLM_PROVIDER=bedrock
MAX_TOKENS=1000

# groq (only needed when LLM_PROVIDER=groq)
GROQ_API_KEY="our_key"
MODEL_NAME=openai/gpt-oss-120b

# bedrock (only needed when LLM_PROVIDER=bedrock)
# credentials come from the EC2 IAM role, never put AWS keys here
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-micro-v1:0

# public hostname for HTTPS; leave unset to serve plain HTTP on port 80
# DOMAIN=13-201-5-7.sslip.io

# rate limits (optional, these are the defaults)
USER_LIMIT_PER_MINUTE=10
GLOBAL_LIMIT_PER_MINUTE=30
GLOBAL_LIMIT_PER_DAY=1000

# database (docker-compose builds the backend's DATABASE_URL from these)
# letters and digits only, it goes inside a URL:
#   python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_USER=llm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=llm_chat
# used when you run uvicorn on your laptop (Docker overrides it)
DATABASE_URL=postgresql+psycopg://llm:change_me@localhost:5432/llm_chat

# auth: anyone with this secret can log in as any user, keep it out of git
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me
JWT_EXPIRE_MINUTES=1440